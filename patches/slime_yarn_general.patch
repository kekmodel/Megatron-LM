-    # rope_type
+    # rope_type / position_embedding_type defaults
+    # Don't override if user specified via CLI (--position-embedding-type yarn)
      if hasattr(args, 'rope_type') and args.rope_type is None:
-        args.rope_type = 'yarn' if args.multi_latent_attention else 'rope'
+        if hasattr(args, 'position_embedding_type') and args.position_embedding_type is not None:
+            # Use position_embedding_type if set (e.g., via --enable-gpt-oss)
+            args.rope_type = args.position_embedding_type
+        else:
+            args.rope_type = 'yarn' if getattr(args, 'multi_latent_attention', False) else 'rope'

