# SLIME YaRN General Patch
# Supports GPT-OSS, Qwen, and other YaRN models
# Apply with: patch -p1 < slime_yarn_general.patch
# Run from SLIME root directory

--- a/slime/backends/megatron_utils/model_provider.py
+++ b/slime/backends/megatron_utils/model_provider.py
@@ -1,5 +1,6 @@
 # Model provider for Megatron-LM
+from typing import Literal

 def get_model_provider_func(
     args,
@@ -10,7 +11,12 @@ def get_model_provider_func(
     Returns a model provider function for Megatron's get_model().
     """

-    def model_provider(pre_process=True, post_process=True, vp_stage=None):
+    def model_provider(
+        pre_process=True,
+        post_process=True,
+        vp_stage=None,
+        **kwargs,  # v0.15.0 passes config=, pg_collection=
+    ):
         """Build the model."""
         from megatron.core.models.gpt import GPTModel
         from megatron.training.arguments import core_transformer_config_from_args
@@ -20,6 +26,8 @@ def get_model_provider_func(

         use_te = args.transformer_impl == "transformer_engine"

+        # NOTE: YaRN config (--enable-gpt-oss, --yarn-* args) is handled
+        # in core_transformer_config_from_args automatically
         config = core_transformer_config_from_args(args)

         # Build GPTModel kwargs
@@ -35,8 +43,6 @@ def get_model_provider_func(
             "parallel_output": True,
             "share_embeddings_and_output_weights": not args.untie_embeddings_and_output_weights,
             "rotary_percent": args.rotary_percent,
-            # Do NOT pass position_embedding_type here - it comes from config
-            # "position_embedding_type": args.position_embedding_type,
         }

         model = GPTModel(**model_kwargs)
@@ -44,6 +50,7 @@ def get_model_provider_func(

     return model_provider

+
